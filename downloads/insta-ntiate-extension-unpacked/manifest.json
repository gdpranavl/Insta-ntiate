{
  "manifest_version": 3,
  "name": "Insta-ntiate Collector",
  "version": "0.1.0",
  "description": "Harvest top Instagram saved collections into a local searchable archive.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["https://www.instagram.com/*", "http://localhost:3000/*"],
  "action": {
    "default_title": "Insta-ntiate",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
